APP_ENV=qa
APP_SECRET_KEY=<generate-a-different-secret-for-qa>
DATABASE_URL=<qa-postgres-url>
REDIS_URL=<qa-redis-url-if-used>
CORS_ORIGINS=https://<qa-vercel-domain>
ALLOWED_HOSTS=healthcheck.railway.app,*.up.railway.app,<qa-api-host>
ADMIN_EMAILS=<owner-email>
ADZUNA_APP_ID=<qa-or-shared-adzuna-id>
ADZUNA_APP_KEY=<qa-or-shared-adzuna-key>
ADZUNA_COUNTRY=in
REMOTIVE_ENABLED=true
GEMINI_API_KEY=<qa-gemini-key>
GEMINI_MODEL=gemini-2.5-flash
NEXT_PUBLIC_API_URL=https://<qa-railway-api-domain>/api/v1
