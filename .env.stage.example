APP_ENV=stage
APP_SECRET_KEY=<generate-a-different-secret-for-stage>
DATABASE_URL=<stage-postgres-url>
REDIS_URL=<stage-redis-url-if-used>
CORS_ORIGINS=https://<stage-vercel-domain>
ALLOWED_HOSTS=healthcheck.railway.app,*.up.railway.app,<stage-api-host>
ADMIN_EMAILS=<owner-email>
ADZUNA_APP_ID=<stage-or-shared-adzuna-id>
ADZUNA_APP_KEY=<stage-or-shared-adzuna-key>
ADZUNA_COUNTRY=in
REMOTIVE_ENABLED=true
GEMINI_API_KEY=<stage-gemini-key>
GEMINI_MODEL=gemini-2.5-flash
NEXT_PUBLIC_API_URL=https://<stage-railway-api-domain>/api/v1
