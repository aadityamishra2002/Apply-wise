APP_ENV=development
APP_SECRET_KEY=change-me-before-production
DATABASE_URL=postgresql+asyncpg://jobcopilot:jobcopilot@localhost:5432/jobcopilot
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=*
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=jobcopilot_refresh
JWT_ISSUER=job-application-copilot
ENABLE_API_DOCS=true
LOG_LEVEL=INFO
LOG_FORMAT=text
ADMIN_EMAILS=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
REMOTIVE_ENABLED=true
REMOTIVE_RESULTS_LIMIT=20
REMOTIVE_TIMEOUT_SECONDS=10
REMOTIVE_CACHE_MINUTES=15
PROVIDER_RETRY_ATTEMPTS=2
PROVIDER_RETRY_BASE_DELAY_SECONDS=0.2
PROVIDER_RETRY_MAX_DELAY_SECONDS=1
EXPORT_RETRY_ATTEMPTS=2
EXPORT_RETRY_BASE_DELAY_SECONDS=0.1
EXPORT_RETRY_MAX_DELAY_SECONDS=0.5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_BASE_DELAY_SECONDS=0.25
GEMINI_RETRY_MAX_DELAY_SECONDS=2
ATS_KEYWORDS_WEIGHT=0.5
ATS_SECTIONS_WEIGHT=0.2
ATS_FORMATTING_WEIGHT=0.15
ATS_PARSE_READINESS_WEIGHT=0.15
ATS_HIGH_FIT_THRESHOLD=80
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_REQUESTS=240
RATE_LIMIT_SENSITIVE_REQUESTS=30
