APP_ENV=development
APP_SECRET_KEY=change-me-before-production
DATABASE_URL=postgresql+asyncpg://jobcopilot:jobcopilot@postgres:5432/jobcopilot
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=*
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=jobcopilot_refresh
JWT_ISSUER=job-application-copilot
ENABLE_API_DOCS=true
LOG_LEVEL=INFO
LOG_FORMAT=text
ADMIN_EMAILS=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ATS_KEYWORDS_WEIGHT=0.5
ATS_SECTIONS_WEIGHT=0.2
ATS_FORMATTING_WEIGHT=0.15
ATS_PARSE_READINESS_WEIGHT=0.15
ATS_HIGH_FIT_THRESHOLD=80
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
